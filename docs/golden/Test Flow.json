{
  "version": "1.1",
  "name": "Test Flow",
  "runMode": "per-row",
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 2,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"ServiceCode1\"]",
      "value": "{{Service Code}}"
    },
    {
      "id": 3,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"UnitPrice1\"]",
      "value": "{{Price }}"
    },
    {
      "id": 4,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Schedule\"]",
      "value": "{{Schedule}}"
    },
    {
      "id": 6,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 5,
      "type": "checkbox",
      "open": false,
      "checkAction": "uncheck",
      "waitType": "fixed",
      "selector": "input[name=\"Active\"]"
    },
    {
      "id": 7,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "value": "07/10/2026",
      "selector": "input[name=\"StartDate\"]"
    },
    {
      "id": 8,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"CancelDate\"]",
      "value": "07/10/2026"
    },
    {
      "id": 9,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "value": "ADMIN ERR",
      "selector": "input[name=\"CancelReason\"]"
    },
    {
      "id": 10,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Tech1\"]",
      "value": "{{Tech 1}}"
    },
    {
      "id": 11,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Tech4\"]",
      "value": "{{Tech 2}}"
    },
    {
      "id": 13,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"LastGeneratedDate\"]",
      "value": "07/10/2026"
    },
    {
      "id": 14,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Duration\"]",
      "value": "{{Duration}}"
    },
    {
      "id": 16,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"PriceIncrDate\"]",
      "value": "07/10/2026"
    },
    {
      "id": 15,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 12,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butAdd\"]",
      "waitFor": "button[name=\"butHistoryShow\"]"
    },
    {
      "id": 17,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "findByText": true,
      "containerSel": "table[name=\"ProgramsTable\"]",
      "matchText": "BALFWD"
    },
    {
      "id": 19,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 18,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butDelete\"]",
      "waitFor": "button[name=\"butHistoryShow\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "retry",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "2",
    "breakerThreshold": "20",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}