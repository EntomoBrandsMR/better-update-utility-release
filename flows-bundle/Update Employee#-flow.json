{
  "version": "1.0",
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 2,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butShowAll\"]",
      "waitFor": "button[name=\"butHideAll\"]"
    },
    {
      "id": 3,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"UserDef37\"]",
      "value": "{{Position ID}}"
    },
    {
      "id": 4,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"EmployeeNum\"]",
      "value": "{{Emplyee#}}"
    },
    {
      "id": 6,
      "type": "dialog",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 7,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butSave\"]",
      "waitFor": "button[name=\"butSendVerificationEmails\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "retry",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "2",
    "breakerThreshold": "20",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}