{
  "version": "1.1",
  "name": "Schedule Test-flow",
  "runMode": "once",
  "automation": true,
  "poolSettings": {
    "maxWorkers": 1,
    "startWorkers": 1,
    "hwSlider": 4,
    "ppSlider": 4,
    "evalMin": 2,
    "elastic": false,
    "diag": false,
    "diagCap": 10,
    "startMode": "run-all"
  },
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "https://app.pestpac.com/billto/notes/default.asp?BillToID=1446430",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 4,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "after": "element",
      "selector": "button[name=\"butAdd\"]",
      "dialogAccept": true,
      "dialogDecline": false,
      "afterSelector": "textarea[name=\"Note\"]"
    },
    {
      "id": 2,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "textarea[name=\"Note\"]",
      "value": "BUU Schedule Test 9"
    },
    {
      "id": 5,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "value": "ACCT NOTE",
      "selector": "input[name=\"NoteCode\"]",
      "dialogAccept": false,
      "dialogDecline": false
    },
    {
      "id": 3,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "after": "element",
      "dialogAccept": true,
      "dialogDecline": false,
      "selector": "button[name=\"butSaveNote\"]",
      "afterSelector": "button[name=\"butAdd\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "load",
    "retryCount": "0",
    "reauthInterval": "0",
    "flowNotes": "Rebuilt 2026-07-17 from pool journal meta after the manual-install wipe. Save-step After changed url->element.",
    "headless": true
  }
}