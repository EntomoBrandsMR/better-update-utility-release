{
  "version": "1.1",
  "name": "Deactivate Location-flow",
  "runMode": "per-row",
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "https://app.pestpac.com/search/default.asp",
      "waitAfter": "load",
      "open": true
    },
    {
      "id": 2,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"LocationCode\"]",
      "value": "{{Location Code}}"
    },
    {
      "id": 5,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 3,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "#butSearch",
      "waitFor": "button[name=\"butHistoryShow\"]"
    },
    {
      "id": 6,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 4,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "#locationHeaderDetailLink",
      "waitFor": "button[name=\"butDelete\"]"
    },
    {
      "id": 7,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 8,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butDelete\"]",
      "waitFor": "button[name=\"butHistoryShow\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "breakerThreshold": "2000",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}