{
  "version": "1.1",
  "name": "Add Billing Note-flow",
  "runMode": "per-row",
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{BT URL}}",
      "waitAfter": "load",
      "open": true
    },
    {
      "id": 2,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butNotes\"]",
      "waitFor": "button[name=\"butAdd\"]"
    },
    {
      "id": 3,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butAdd\"]",
      "waitFor": "button[name=\"butSaveNote\"]"
    },
    {
      "id": 5,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "textarea[name=\"Note\"]",
      "value": "{{Note}}"
    },
    {
      "id": 9,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "value": "BILLG/COLL",
      "selector": "input[name=\"NoteCode\"]"
    },
    {
      "id": 6,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butSaveNote\"]",
      "waitFor": "button[name=\"butAdd\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "breakerThreshold": "200000",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}