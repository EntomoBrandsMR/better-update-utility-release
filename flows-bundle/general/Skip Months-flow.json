{
  "version": "1.1",
  "name": "Skip Months-flow",
  "runMode": "per-row",
  "automation": false,
  "poolSettings": {
    "maxWorkers": 16,
    "startWorkers": 5,
    "hwSlider": 4,
    "ppSlider": 4,
    "evalMin": 2,
    "elastic": true,
    "diag": true,
    "diagCap": 10,
    "startMode": "step"
  },
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 2,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "after": "element",
      "selector": "button[name=\"butEdit\"]",
      "afterSelector": "button[name=\"butSaveTop\"]"
    },
    {
      "id": 3,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Skip1\"]"
    },
    {
      "id": 4,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Skip2\"]"
    },
    {
      "id": 5,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Skip3\"]"
    },
    {
      "id": 6,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Skip11\"]"
    },
    {
      "id": 7,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Skip12\"]"
    },
    {
      "id": 8,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "after": "element",
      "selector": "button[name=\"butSaveTop\"]",
      "dialogAccept": true,
      "dialogDecline": false,
      "afterSelector": "button[name=\"butHistoryShow\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "45",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  },
  "lastGoodWorkers": 5
}