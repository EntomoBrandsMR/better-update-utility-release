{
  "version": "1.1",
  "name": "Post Service Order on Deactivated Account-flow",
  "runMode": "per-row",
  "automation": false,
  "poolSettings": {
    "maxWorkers": 15,
    "startWorkers": 1,
    "hwSlider": 4,
    "ppSlider": 4,
    "evalMin": 2,
    "elastic": true,
    "diag": false,
    "diagCap": 10,
    "startMode": "step"
  },
  "setupFlowId": "Open Empty Batch-flow",
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 3,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butExit\"]",
      "waitFor": "button[name=\"butHistoryShow\"]"
    },
    {
      "id": 4,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butActivate\"]",
      "dialogAccept": true,
      "dialogDecline": false
    },
    {
      "id": 6,
      "type": "navigate",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "url": "{{URL}}"
    },
    {
      "id": 7,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butPost\"]",
      "waitFor": "button[name=\"PostNew\"]",
      "dialogAccept": true,
      "dialogDecline": false
    },
    {
      "id": 8,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "xpath=//tr[td[normalize-space(text())='BUU']]//span[@id='Add']"
    },
    {
      "id": 9,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Post1\"]"
    },
    {
      "id": 10,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"WorkDate1\"]",
      "value": "{{TODAY}}"
    },
    {
      "id": 11,
      "type": "select",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "select[name=\"OrderType1\"]",
      "value": "NS - DO NOT USE - HQ Cleanup"
    },
    {
      "id": 12,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "textarea[name=\"FieldComment1\"]",
      "value": "{{Note}}"
    },
    {
      "id": 13,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butPost\"]",
      "waitFor": "button[name=\"NewBatch\"]",
      "dialogAccept": true,
      "dialogDecline": false
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "2",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}