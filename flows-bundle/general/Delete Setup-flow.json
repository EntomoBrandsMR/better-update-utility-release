{
  "version": "1.1",
  "name": "Delete Setup-flow",
  "runMode": "per-row",
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{Setup URL}}",
      "waitAfter": "load",
      "open": true
    },
    {
      "id": 3,
      "type": "dialog",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 2,
      "type": "click",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butDelete\"]",
      "waitFor": "button[name=\"butHistoryShow\"]"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "breakerThreshold": "8900000",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}