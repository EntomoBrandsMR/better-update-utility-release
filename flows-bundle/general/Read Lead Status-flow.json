{
  "version": "1.1",
  "name": "Read Lead Status-flow",
  "runMode": "per-row",
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": true
    },
    {
      "id": 2,
      "type": "readfield",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "readMode": "both",
      "readOnMissing": "blank",
      "selector": "select[name=\"WonStatus\"]",
      "colName": "Won Status"
    },
    {
      "id": 3,
      "type": "readfield",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "readMode": "both",
      "readOnMissing": "blank",
      "selector": "input[name=\"CloseReason\"]",
      "colName": "Close Reason"
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "retry",
    "selectorTimeout": "90",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "2",
    "breakerThreshold": "20",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}