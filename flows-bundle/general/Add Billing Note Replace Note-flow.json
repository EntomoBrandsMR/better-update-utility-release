{
  "version": "1.1",
  "name": "Add Billing Note Replace Note-flow",
  "runMode": "per-row",
  "automation": false,
  "poolSettings": {
    "maxWorkers": 12,
    "startWorkers": 1,
    "hwSlider": 4,
    "ppSlider": 4,
    "evalMin": 2,
    "elastic": true,
    "diag": false,
    "diagCap": 10,
    "startMode": "step"
  },
  "setupFlowId": null,
  "teardownFlowId": null,
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{BT URL}}",
      "waitAfter": "load",
      "open": false,
      "dialogAccept": true,
      "dialogDecline": false
    },
    {
      "id": 2,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butNotes\"]",
      "waitFor": "button[name=\"butAdd\"]",
      "dialogAccept": true,
      "dialogDecline": false
    },
    {
      "id": 3,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "//tr[td[contains(normalize-space(), '07/15/2026')] and td[normalize-space()='BUU'] and td[normalize-space()='BILLG/COLL'] and following-sibling::tr[1]/td[contains(., 'Sent Renewal Notice') and contains(., '07/15/2026')]]//a[normalize-space()='Edit']",
      "waitFor": "button[name=\"butSaveNote\"]",
      "afterSelector": "button[name=\"butDelete\"]",
      "dialogAccept": true,
      "dialogDecline": false
    },
    {
      "id": 5,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "textarea[name=\"Note\"]",
      "value": "{{New Note}}"
    },
    {
      "id": 6,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butSave\"]",
      "waitFor": "button[name=\"butAdd\"]",
      "dialogAccept": true,
      "dialogDecline": false
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  },
  "lastGoodWorkers": 8
}