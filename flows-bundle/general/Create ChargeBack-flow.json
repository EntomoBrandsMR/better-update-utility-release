{
  "version": "1.1",
  "name": "Create ChargeBack-flow",
  "runMode": "per-row",
  "setupFlowId": "Open Empty Batch-flow",
  "teardownFlowId": "Release Batch-flow",
  "steps": [
    {
      "id": 1,
      "type": "navigate",
      "url": "{{URL}}",
      "waitAfter": "load",
      "open": false
    },
    {
      "id": 23,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 2,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butOrder\"]",
      "waitFor": "button[name=\"butSave\"]"
    },
    {
      "id": 3,
      "type": "type",
      "open": true,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"ServiceCode1\"]",
      "value": "{{Service Code }}"
    },
    {
      "id": 5,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Quantity1\"]",
      "value": "{{# of Services to Charge Back}}"
    },
    {
      "id": 4,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"UnitPrice1\"]",
      "value": "{{Neg Subtotal}}"
    },
    {
      "id": 6,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"WorkDate\"]",
      "value": "07/09/2026"
    },
    {
      "id": 7,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Duration\"]",
      "value": "00:01"
    },
    {
      "id": 8,
      "type": "select",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "select[name=\"OrderType\"]",
      "value": "Commission"
    },
    {
      "id": 9,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Tech1\"]",
      "value": "BILLING"
    },
    {
      "id": 10,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Tech4\"]",
      "value": "{{Sales}}"
    },
    {
      "id": 11,
      "type": "type",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "textarea[name=\"Comment\"]",
      "value": "{{Order Instructions}}"
    },
    {
      "id": 20,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 12,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butSave\"]",
      "waitFor": ""
    },
    {
      "id": 24,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 13,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butCancel\"]",
      "waitFor": "button[name=\"butPost\"]"
    },
    {
      "id": 25,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 14,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butPost\"]",
      "waitFor": "button[name=\"PostNew\"]"
    },
    {
      "id": 22,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 17,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "xpath=//tr[td[normalize-space(text())='BUU']]//span[@id='Add']"
    },
    {
      "id": 21,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 15,
      "type": "checkbox",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "input[name=\"Post1\"]"
    },
    {
      "id": 18,
      "type": "dialog",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed"
    },
    {
      "id": 19,
      "type": "click",
      "open": false,
      "checkAction": "check",
      "waitType": "fixed",
      "selector": "button[name=\"butPost\"]",
      "debugClick": true
    }
  ],
  "config": {
    "rowDelayMin": "0",
    "rowDelayMax": "0",
    "errHandle": "skip",
    "selectorTimeout": "30",
    "pageLoadMode": "domcontentloaded",
    "retryCount": "0",
    "breakerThreshold": "200000",
    "reauthInterval": "120",
    "flowNotes": "",
    "headless": false
  }
}